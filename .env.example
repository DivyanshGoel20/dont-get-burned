# Copy to .env and paste your key there. .env is git-ignored and never committed.
# Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# First model is used; the rest are fallbacks if it's unavailable.
LLM_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
LLM_REASONING_EFFORT=low
# Set to 1 to log each model attempt and its timing in the dev server output.
# LLM_DEBUG=1
