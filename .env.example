# Copy to .env and paste your key there. .env is git-ignored and never committed.
# Keep the key in ONE file only: an empty AGENTROUTER_API_KEY in .env.local would override .env.
# AgentRouter: get a key at https://agentrouter.org (console → token).
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# First model is used; the rest are fallbacks if it's unavailable (see agentrouter.org pricing page for names).
AGENTROUTER_MODEL=gpt-5.6-sol,gpt-6.1-sol
