# Copy to .env.local and paste your key there. .env.local is git-ignored and never committed.
# AgentRouter: get a key at https://agentrouter.org (console → token).
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# First model is used; the rest are fallbacks if it's unavailable (see agentrouter.org pricing page for names).
AGENTROUTER_MODEL=deepseek-v4-flash,glm-5.3
